sful authentication, get the authentication token\n//         const userAuthToken = await user.getAuthToken();\n  \n//         // Now you have the authentication token\n//         console.log('Authentication Token:', userAuthToken);\n  \n//         // Continue with loading user info\n//         loadUserInfo();\n//       };\n  \n//       authenticateUser();\n  \n//     // loadUserInfo();\n//     return () => {\n//         isMounted = false;\n//       };\n//   }, []);\n\n//   return {\n//     loading,\n//     userInfo,\n//     // handleSignOut,\n//   };\n// };\n\n// export default usePassageUserInfo;\n\n// ----------\n\n\nimport { usePassage } from \"@passageidentity/passage-react\";\nimport { useState, useEffect } from \"react\";\n\nexport const usePassageUserInfo = () => {\n  const [loading, setLoading] = useState(false);\n  const [userInfo, setUserInfo] = useState();\n\n  const { getCurrentUser } = usePassage();\n\n  useEffect(() => {\n    const loadUserInfo = async () => {\n      setLoading(true);\n\n      try {\n        const userInfo = await getCurrentUser().userInfo();\n        setUserInfo(userInfo);\n      } catch (err) {\n        setUserInfo(undefined);\n      } finally {\n        setLoading(false);\n      }\n    };\n    loadUserInfo();\n  }, []);\n\n  return {\n    loading,\n    userInfo,\n  };\n};\n\nexport default usePassageUserInfo;","/Users/ingridf/Documents/chase-runner/src/views/Signup.jsx",["202"],[],"import { useAuth0 } from \"@auth0/auth0-react\";\nimport React from \"react\";\nimport styles from \"../styles/Login.module.css\";\n\nconst Signup = () => {\n  const { loginWithRedirect, isAuthenticated } = useAuth0();\n\n  const handleSignUp = async () => {\n    await loginWithRedirect({\n      appState: {\n        returnTo: \"/map\",\n      },\n      authorizationParams: {\n        screen_hint: \"signup\",\n      },\n    });\n  };\n\n  return (\n    <>\n      <button onClick={handleSignUp} className={styles.buttonLogin}>\n        <h3 className={styles.link}> Sign Up </h3>\n      </button>\n    </>\n  );\n};\n\nexport default Signup;\n","/Users/ingridf/Documents/chase-runner/src/views/Logout.jsx",[],[],"/Users/ingridf/Documents/chase-runner/src/views/SearchInput.jsx",[],[],"/Users/ingridf/Documents/chase-runner/src/context/UserContext.jsx",[],[],[],"/Users/ingridf/Documents/chase-runner/src/views/RunningShoesSpinner.jsx",[],[],"/Users/ingridf/Documents/chase-runner/src/views/Callback.jsx",[],[],{"ruleId":"203","severity":1,"message":"204","line":1,"column":8,"nodeType":"205","messageId":"206","endLine":1,"endColumn":13},{"ruleId":"203","severity":1,"message":"207","line":9,"column":8,"nodeType":"205","messageId":"206","endLine":9,"endColumn":25},{"ruleId":"203","severity":1,"message":"208","line":11,"column":8,"nodeType":"205","messageId":"206","endLine":11,"endColumn":9},{"ruleId":"203","severity":1,"message":"209","line":12,"column":8,"nodeType":"205","messageId":"206","endLine":12,"endColumn":11},{"ruleId":"203","severity":1,"message":"210","line":13,"column":8,"nodeType":"205","messageId":"206","endLine":13,"endColumn":14},{"ruleId":"203","severity":1,"message":"211","line":14,"column":8,"nodeType":"205","messageId":"206","endLine":14,"endColumn":12},{"ruleId":"203","severity":1,"message":"212","line":15,"column":8,"nodeType":"205","messageId":"206","endLine":15,"endColumn":14},{"ruleId":"203","severity":1,"message":"213","line":16,"column":8,"nodeType":"205","messageId":"206","endLine":16,"endColumn":13},{"ruleId":"203","severity":1,"message":"214","line":17,"column":10,"nodeType":"205","messageId":"206","endLine":17,"endColumn":21},{"ruleId":"203","severity":1,"message":"215","line":27,"column":5,"nodeType":"205","messageId":"206","endLine":27,"endColumn":17},{"ruleId":"203","severity":1,"message":"216","line":30,"column":5,"nodeType":"205","messageId":"206","endLine":30,"endColumn":16},{"ruleId":"203","severity":1,"message":"217","line":33,"column":10,"nodeType":"205","messageId":"206","endLine":33,"endColu